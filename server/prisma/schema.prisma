
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  bio          String?
  location     String?
  profileImage String?
  skills       String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects          Project[]
  posts             BlogPost[]
  feedPosts         FeedPost[]
  sentConnections  Connection[] @relation("SentConnections")
  receivedConnections Connection[] @relation("ReceivedConnections")
  endorsementsGiven    Endorsement[] @relation("EndorsementsGiven")
  endorsementsReceived Endorsement[] @relation("EndorsementsReceived")
  notifications        Notification[]
}

model Project {
  id           String   @id @default(cuid())
  title        String
  description  String
  technologies String[] @default([])
  githubUrl    String?
  liveUrl      String?
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  content   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeedPost {
  id        String   @id @default(cuid())
  content   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId, createdAt])
}

model Connection {
  id         String           @id @default(cuid())
  senderId   String
  receiverId String
  status     ConnectionStatus @default(PENDING)

  sender   User @relation("SentConnections", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedConnections", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
}

model Endorsement {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  skill      String
  createdAt  DateTime @default(now())

  fromUser User @relation("EndorsementsGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("EndorsementsReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId, skill])
  @@index([toUserId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}
